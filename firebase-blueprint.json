        "previousLevel": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "newLevel": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "previousLevelMode": { "type": "string", "enum": ["AUTOMATIC", "MANUAL_OVERRIDE", "RESET"] },
        "newLevelMode": { "type": "string", "enum": ["AUTOMATIC", "MANUAL_OVERRIDE", "RESET"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300 },
        "reference": { "type": "string", "maxLength": 120 },
        "auditId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 160 },
        "adminRole": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN"] },
        "cycleId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "timestamp": { "type": "integer" }
      },
      "required": [
        "id",
        "operationId",
        "action",
        "memberId",
        "memberUid",
        "memberUsername",
        "xpProgressSnapshot",
        "previousLevel",
        "newLevel",
        "previousLevelMode",
        "newLevelMode",
        "reason",
        "reference",
        "auditId",
        "adminId",
        "adminEmail",
        "adminRole",
        "cycleId",
        "timestamp"
      ]
