        "kind": { "type": "string", "enum": ["PROGRESS", "REWARD"] },
        "memberId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "memberUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUsername": { "type": "string", "minLength": 3, "maxLength": 24 },
        "adjustment": { "type": "integer" },
        "beforeBalance": { "type": "integer" },
        "afterBalance": { "type": "integer" },
        "beforeXpProgress": { "type": "integer" },
        "afterXpProgress": { "type": "integer" },
        "beforeXpReward": { "type": "integer" },
        "afterXpReward": { "type": "integer" },
        "levelBefore": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "levelAfter": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300 },
        "reference": { "type": "string", "maxLength": 120 },
        "auditId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 160 },
        "adminRole": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN"] },
        "cycleId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "timestamp": { "type": "integer" }
      },
      "required": [
        "id",
        "operationId",
        "kind",
        "memberId",
        "memberUid",
        "memberUsername",
        "adjustment",
        "beforeBalance",
        "afterBalance",
        "beforeXpProgress",
        "afterXpProgress",
        "beforeXpReward",
        "afterXpReward",
        "levelBefore",
        "levelAfter",
        "reason",
        "reference",
        "auditId",
        "adminId",
        "adminEmail",
        "adminRole",
        "cycleId",
        "timestamp"
      ]
    },
