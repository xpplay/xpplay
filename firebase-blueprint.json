{
  "entities": {
    "Branch": {
      "title": "Branch",
      "description": "Cabang XP PLAY (Demang atau Sekip)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "subtitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "whatsapp": { "type": "string", "minLength": 8, "maxLength": 20 },
        "mapsUrl": { "type": "string", "minLength": 10, "maxLength": 300 },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "subtitle", "whatsapp", "mapsUrl", "active"]
    },
    "LevelConfig": {
      "title": "LevelConfig",
      "description": "Konfigurasi threshold level member berdasarkan XP Progress",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 40 },
        "rank": { "type": "integer" },
        "minXp": { "type": "integer" },
        "colorHex": { "type": "string", "minLength": 4, "maxLength": 12 },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name", "rank", "minXp", "colorHex", "description"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Konfigurasi sistem XP rate, bonus, dan jadwal reset cycle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "transactionXpRate": { "type": "integer" },
        "registrationBonusXp": { "type": "integer" },
        "referralBonusXp": { "type": "integer" },
        "refundOnExpiry": { "type": "boolean" },
        "currentCycleId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "resetEnabled": { "type": "boolean" },
        "resetInterval": { "type": "integer" },
        "resetUnit": { "type": "string", "enum": ["DAYS", "MONTHS"] },
        "nextResetAt": { "type": "integer" },
        "resetXpProgress": { "type": "boolean" },
        "resetLevel": { "type": "boolean" },
        "resetXpReward": { "type": "boolean" },
        "updatedAt": { "type": "integer" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": [
        "id",
        "transactionXpRate",
        "registrationBonusXp",
        "referralBonusXp",
        "currentCycleId",
        "resetEnabled",
        "resetInterval",
        "resetUnit",
        "resetXpProgress",
        "resetLevel",
        "resetXpReward",
        "updatedAt",
        "updatedBy"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Operator dan pengelola sistem dengan RBAC 4-Role (SUPER_ADMIN, ADMIN, CASHIER, STAFF legacy)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CASHIER", "STAFF"] },
        "branchScope": { "type": "string", "enum": ["ALL", "DEMANG", "SEKIP"] },
        "branchId": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "cashierCode": { "type": "string", "maxLength": 40 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["uid", "email", "fullName", "role", "branchScope", "active", "createdAt", "updatedAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Undangan otorisasi operator Admin/Kasir berbasis email tanpa input manual Firebase Auth UID",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CASHIER", "STAFF"] },
        "branchScope": { "type": "string", "enum": ["ALL", "DEMANG", "SEKIP"] },
        "branchId": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "cashierCode": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["PENDING", "CLAIMED"] },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "claimedByUid": { "type": "string", "maxLength": 128 },
        "claimedAt": { "type": "integer" }
      },
      "required": ["email", "fullName", "role", "branchScope", "status", "active", "createdBy", "createdAt", "updatedAt"]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Profil member XP PLAY dengan pemisahan saldo XP Progress dan XP Reward",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "username": { "type": "string", "maxLength": 24 },
        "whatsapp": { "type": "string", "minLength": 10, "maxLength": 16, "pattern": "^628[1-9][0-9]{6,11}$" },
        "socialMedia": { "type": "string", "maxLength": 100 },
        "birthDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "birthMonth": { "type": "integer" },
        "birthDay": { "type": "integer" },
        "memberCategory": { "type": "string", "enum": ["MAHASISWA", "PELAJAR", "PEKERJA", "LAINNYA"] },
        "status": { "type": "string", "enum": ["PRE_REGISTERED", "ACTIVE", "SUSPENDED", "INACTIVE", "DELETED"] },
        "registrationStatus": { "type": "string", "enum": ["PRE_REGISTERED", "ACTIVE", "SUSPENDED", "INACTIVE", "DELETED"] },
        "registrationStage": { "type": "string", "enum": ["PHONE_ONLY", "COMPLETED"] },
        "phone": { "type": "string", "maxLength": 20 },
        "normalizedPhone": { "type": "string", "maxLength": 20 },
        "branchId": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "preRegisteredAt": { "type": "integer" },
        "preRegisteredBy": { "type": "string", "maxLength": 128 },
        "preRegisteredByRole": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CASHIER", "STAFF"] },
        "preRegistrationNotes": { "type": "string", "maxLength": 300 },
        "registrationCompletedAt": { "type": "integer" },
        "verifiedPhoneAt": { "type": "integer" },
        "registrationBonusGranted": { "type": "boolean" },
        "authUid": { "type": "string", "maxLength": 128 },
        "migratedFromUid": { "type": "string", "maxLength": 128 },
        "mergedIntoUid": { "type": "string", "maxLength": 128 },
        "xpProgress": { "type": "integer" },
        "xpReward": { "type": "integer" },
        "reservedXp": { "type": "integer" },
        "currentLevel": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "levelMode": { "type": "string", "enum": ["AUTOMATIC", "MANUAL_OVERRIDE", "RESET"] },
        "currentCycleId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "referredByUid": { "type": "string", "maxLength": 128 },
        "referredByUsername": { "type": "string", "maxLength": 24 },
        "referralCount": { "type": "integer" },
        "lastPlayAt": { "type": "integer" },
        "lastPlayBranch": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": [
        "uid",
        "memberId",
        "fullName",
        "username",
        "whatsapp",
        "socialMedia",
        "status",
        "xpProgress",
        "xpReward",
        "currentLevel",
        "currentCycleId",
        "referralCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "IdentityIndex": {
      "title": "IdentityIndex",
      "description": "Mapping internal username/WhatsApp unik untuk server-side auth lookup",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authEmail": { "type": "string", "maxLength": 180 },
        "kind": { "type": "string", "enum": ["USERNAME", "WHATSAPP"] },
        "value": { "type": "string", "minLength": 3, "maxLength": 32 },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "authEmail", "kind", "value", "createdAt"]
    },
    "AuthIndex": {
      "title": "AuthIndex",
      "description": "Index lookup SHA-256 zero-PII untuk login username/WhatsApp + password",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authEmail": { "type": "string", "minLength": 10, "maxLength": 120 },
        "kind": { "type": "string", "enum": ["USERNAME", "WHATSAPP"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "authEmail", "kind", "createdAt"]
    },
    "XpLedgerEntry": {
      "title": "XpLedgerEntry",
      "description": "Buku besar immutable XP Progress atau XP Reward (termasuk ADMIN_ADJUSTMENT dan XP_REWARD_ADMIN_ADJUSTMENT)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "memberUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUsername": { "type": "string", "minLength": 3, "maxLength": 24 },
        "amount": { "type": "integer" },
        "beforeBalance": { "type": "integer" },
        "afterBalance": { "type": "integer" },
        "type": { "type": "string", "enum": ["PROGRESS", "REWARD"] },
        "direction": { "type": "string", "enum": ["CREDIT", "DEBIT"] },
        "source": {
          "type": "string",
          "enum": [
            "REGISTRATION",
            "REGISTRATION_BONUS",
            "REFERRAL",
            "TRANSACTION",
            "CHALLENGE",
            "EVENT",
            "PROMO",
            "LEVEL_BONUS",
            "ADMIN_ADD",
            "ADMIN_ADJUSTMENT",
            "XP_REWARD_ADMIN_ADJUSTMENT",
            "BENEFIT_REQUEST_HOLD",
            "REDEMPTION",
            "ADMIN_DEDUCT",
            "TRANSACTION_REVERSAL",
            "DENIED_REFUND",
            "EXPIRY_REFUND",
            "ADMIN_REFUND",
            "REVERSAL_REFUND",
            "RESET"
          ]
        },
        "referenceId": { "type": "string", "maxLength": 128 },
        "cycleId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "createdAt": { "type": "integer" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "memberId", "memberUid", "amount", "type", "direction", "source", "referenceId", "cycleId", "createdAt", "createdBy", "note"]
    },
    "BenefitRequestRecord": {
      "title": "BenefitRequestRecord",
      "description": "Pengajuan benefit terpadu (Benefit Umum/Level, Challenge, Event, Promo) dengan sistem XP Hold, masa berlaku 7 hari, verifikasi kasir MARK AS USED, dan refund otomatis",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "memberUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUsername": { "type": "string", "maxLength": 24 },
        "memberName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "memberWhatsapp": { "type": "string", "minLength": 8, "maxLength": 20 },
        "sourceType": { "type": "string", "enum": ["CHALLENGE", "EVENT", "PROMO", "GENERAL_BENEFIT", "LEVEL_BENEFIT"] },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "xpCost": { "type": "integer" },
        "xpRewardGrant": { "type": "integer" },
        "levelRequirement": { "type": "string", "enum": ["BRONZE", "SILVER", "JURAGAN", "SULTAN"] },
        "evidenceUrl": { "type": "string", "maxLength": 500 },
        "evidencePath": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["ON_PROCESS", "APPROVED", "DENIED", "USED", "EXPIRED", "REFUNDED"] },
        "resolution": { "type": "string", "enum": ["DENIED", "EXPIRED"] },
        "holdLedgerId": { "type": "string", "maxLength": 128 },
        "refundLedgerId": { "type": "string", "maxLength": 128 },
        "branch": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "approvedAt": { "type": "integer" },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByRole": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "CASHIER", "STAFF"] },
        "deniedAt": { "type": "integer" },
        "deniedBy": { "type": "string", "maxLength": 128 },
        "deniedReason": { "type": "string", "maxLength": 300 },
        "expiresAt": { "type": "integer" },
        "expiredAt": { "type": "integer" },
        "usedAt": { "type": "integer" },
        "usedBy": { "type": "string", "maxLength": 128 },
        "usedBranch": { "type": "string", "enum": ["DEMANG", "SEKIP"] },
        "receiptReference": { "type": "string", "maxLength": 100 },
        "refundedAt": { "type": "integer" },
        "refundReason": { "type": "string", "maxLength": 400 },
        "refundedAmount": { "type": "integer" },
        "cycleId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "memberId", "memberUid", "memberUsername", "memberName", "memberWhatsapp", "sourceType", "sourceId", "title", "xpCost", "xpRewardGrant", "levelRequirement", "status", "refundedAmount", "cycleId", "createdAt", "updatedAt"]
    },
    "XpAdjustmentRecord": {
      "title": "XpAdjustmentRecord",
