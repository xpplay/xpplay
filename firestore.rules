        && data.restoreJobId is string && data.restoreJobId.size() >= 6 && data.restoreJobId.size() <= 128
        && data.operationId is string && data.operationId.size() >= 4 && data.operationId.size() <= 128
        && data.targetBackupId is string && data.targetBackupId.size() >= 6 && data.targetBackupId.size() <= 128
        && (data.preRestoreBackupId == null || (data.preRestoreBackupId is string && data.preRestoreBackupId.size() <= 128))
        && data.status in ['REQUESTED', 'VALIDATING', 'LOCKING', 'PRE_RESTORE_BACKUP', 'RESTORING_FIRESTORE', 'RESTORING_STORAGE', 'RESTORING_AUTH_METADATA', 'VERIFYING', 'COMPLETED', 'FAILED', 'VERIFICATION_FAILED', 'CANCELLED']
        && data.requestedBy is string && data.requestedBy.size() >= 1 && data.requestedBy.size() <= 128
        && data.requestedByEmail is string && data.requestedByEmail.size() <= 160
        && data.requestedByRole == 'SUPER_ADMIN'
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300
        && data.startedAt is int
        && (data.completedAt == null || data.completedAt is int)
        && (data.durationMs == null || (data.durationMs is int && data.durationMs >= 0));
    }

    function isValidRestoreJobResults(data) {
      return data.steps is list && data.steps.size() <= 30
        && data.restoredCollectionCounts is map
        && data.expectedCollectionCounts is map
        && data.restoredStorageCount is int && data.restoredStorageCount >= 0
        && data.expectedStorageCount is int && data.expectedStorageCount >= 0
        && data.authRestoreMode in ['METADATA_SYNCED', 'SKIPPED_NO_ADMIN_SDK']
        && data.authRestoreNotice is string && data.authRestoreNotice.size() <= 600
        && data.postRestoreVerificationPassed is bool
        && (data.integrityReport == null || data.integrityReport is map)
        && (data.errorMessage == null || (data.errorMessage is string && data.errorMessage.size() <= 1200))
        && (data.recoveryRecommendation == null || (data.recoveryRecommendation is string && data.recoveryRecommendation.size() <= 1200));
    }

    function isValidRestoreJob(data) {
      return isValidRestoreJobCore(data) && isValidRestoreJobResults(data);
    }

    function isValidRestoreLock(data) {
      return data.keys().hasAll([
          'id', 'locked', 'state', 'restoreJobId', 'backupId',
          'lockedBy', 'lockedByEmail', 'lockedAt', 'updatedAt', 'message'
        ])
        && data.keys().hasOnly([
          'id', 'locked', 'state', 'restoreJobId', 'backupId',
          'lockedBy', 'lockedByEmail', 'lockedAt', 'updatedAt', 'message'
        ])
        && data.id == 'restoreLock'
        && data.locked is bool
        && data.state in ['IDLE', 'RESTORE_IN_PROGRESS']
        && (data.restoreJobId == null || (data.restoreJobId is string && data.restoreJobId.size() <= 128))
        && (data.backupId == null || (data.backupId is string && data.backupId.size() <= 128))
        && (data.lockedBy == null || (data.lockedBy is string && data.lockedBy.size() <= 128))
        && (data.lockedByEmail == null || (data.lockedByEmail is string && data.lockedByEmail.size() <= 160))
        && (data.lockedAt == null || data.lockedAt is int)
        && data.updatedAt is int
        && data.message is string && data.message.size() <= 400;
    }

    function isValidBackupLock(data) {
      return data.keys().hasAll([
          'id', 'locked', 'operationId', 'backupId', 'lockedBy', 'lockedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'locked', 'operationId', 'backupId', 'lockedBy', 'lockedAt', 'updatedAt'
        ])
        && data.id == 'backupLock'
        && data.locked is bool
        && (data.operationId == null || (data.operationId is string && data.operationId.size() <= 128))
        && (data.backupId == null || (data.backupId is string && data.backupId.size() <= 128))
        && (data.lockedBy == null || (data.lockedBy is string && data.lockedBy.size() <= 128))
        && (data.lockedAt == null || data.lockedAt is int)
        && data.updatedAt is int;
    }

    function isValidBackupRetention(data) {
      return data.keys().hasAll([
          'id', 'dailyRetentionCount', 'weeklyRetentionCount', 'monthlyRetentionCount',
          'customMaxAgeDays', 'alwaysKeepLatestSuccessful', 'alwaysKeepLatestPreRestore',
          'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'dailyRetentionCount', 'weeklyRetentionCount', 'monthlyRetentionCount',
          'customMaxAgeDays', 'alwaysKeepLatestSuccessful', 'alwaysKeepLatestPreRestore',
          'updatedAt', 'updatedBy'
        ])
        && data.id == 'backupRetention'
        && data.dailyRetentionCount is int && data.dailyRetentionCount >= 1 && data.dailyRetentionCount <= 90
        && data.weeklyRetentionCount is int && data.weeklyRetentionCount >= 1 && data.weeklyRetentionCount <= 52
        && data.monthlyRetentionCount is int && data.monthlyRetentionCount >= 1 && data.monthlyRetentionCount <= 36
        && data.customMaxAgeDays is int && data.customMaxAgeDays >= 7 && data.customMaxAgeDays <= 3650
        && data.alwaysKeepLatestSuccessful is bool
        && data.alwaysKeepLatestPreRestore is bool
        && data.updatedAt is int
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    // ---------- Connection Check ----------
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // ---------- Public / Config Collections ----------
    match /branches/{branchId} {
      allow get: if isValidId(branchId);
      allow list: if true;
      allow create, update: if isSuperAdmin() && isValidId(branchId) && isValidBranch(incoming());
      allow delete: if isSuperAdminRestoring() && isValidId(branchId);
    }

    match /levels/{levelId} {
      allow get: if isValidId(levelId);
      allow list: if true;
      allow create, update: if isSuperAdmin() && isValidId(levelId) && isValidLevelConfig(incoming());
      allow delete: if isSuperAdminRestoring() && isValidId(levelId);
    }

    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isFullAdminOrSuper();
      allow create, update: if isSuperAdmin() && isValidId(settingId) && isValidSystemSettings(incoming());
      allow delete: if isSuperAdminRestoring() && isValidId(settingId);
    }

    // ---------- Admin & Cashier RBAC Collection ----------
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isFullAdminOrSuper());
      allow list: if isFullAdminOrSuper();
      allow create, update: if isSuperAdmin() && isValidId(uid) && isValidAdminUser(incoming());
      allow delete: if isSuperAdminRestoring() && isValidId(uid) && uid != request.auth.uid;
    }

    // ---------- Internal Identity Mapping (Super Admin Backup/Restore Only) ----------
    match /identityIndex/{indexKey} {
      allow get: if isValidId(indexKey) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdminRestoring() && isValidId(indexKey);
    }

    // ---------- Zero-PII Hashed Auth Lookup (Get by Exact SHA-256 Only; List Super Admin Backup Only) ----------
    match /authIndex/{hashId} {
      allow get: if isValidAuthIndexHash(hashId);
      allow list: if isSuperAdmin();
      allow create: if isValidAuthIndexHash(hashId) && isValidAuthIndex(incoming()) && (
        isSuperAdminRestoring() || (
          isSignedIn()
          && !isSystemRestoreLocked()
          && !exists(/databases/$(database)/documents/authIndex/$(hashId))
          && (isFullAdminOrSuper() || incoming().uid == request.auth.uid)
        )
      );
      allow update: if isSuperAdminRestoring() && isValidAuthIndexHash(hashId) && isValidAuthIndex(incoming());
      allow delete: if isSuperAdminRestoring() && isValidAuthIndexHash(hashId);
    }

    // ---------- Two-Step Onboarding Zero-PII Status & Cryptographic Verifications ----------
    match /onboardingPublicStatus/{wHash} {
      allow get: if isValidWhatsappHash(wHash);
      allow list: if isSuperAdmin();
      allow create, update: if isValidWhatsappHash(wHash) && isValidOnboardingPublicStatus(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper()
          || (
            isCashier()
            && incoming().branchId == cashierBranch()
            && incoming().status == 'PRE_REGISTERED'
          ) || (
            isSignedIn()
            && incoming().status == 'ACTIVE'
            && incoming().hasActiveCode == false
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
          )
        ))
      );
      allow delete: if isSuperAdminRestoring() && isValidWhatsappHash(wHash);
    }

    match /onboardingVerifications/{wHash} {
      allow get: if isValidWhatsappHash(wHash) && (
        isFullAdminOrSuper() || (isCashier() && existing().branchId == cashierBranch())
      );
      allow list: if isSuperAdmin();
      allow create, update: if isValidWhatsappHash(wHash) && isValidOnboardingVerification(incoming()) && incoming().wHash == wHash && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper()
          || (
            isCashier()
            && incoming().branchId == cashierBranch()
            && incoming().issuedBy == request.auth.uid
            && incoming().issuedByRole == adminData().role
          )
        ))
      );
      allow delete: if isSuperAdminRestoring() && isValidWhatsappHash(wHash);
    }

    // ---------- Members Collection (Two-Step Registration + Cashier Branch Isolation) ----------
    match /members/{uid} {
      allow get: if isValidId(uid) && (
        isStaffOperator()
        || (isOwner(uid) && existing().status != 'PRE_REGISTERED')
        || (
          isSignedIn()
          && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
          && isPreRegId(uid)
          && existing().status == 'PRE_REGISTERED'
        )
      );
      allow list: if isStaffOperator();
      allow create: if isValidId(uid) && isValidMemberProfile(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            // Stage 1: Cashier Pre-Registration ONLY (branch-locked, 0 XP, NO bonus)
            isCashier()
            && isPreRegId(uid)
            && incoming().uid == uid
            && incoming().status == 'PRE_REGISTERED'
            && (!('registrationStatus' in incoming()) || incoming().registrationStatus == 'PRE_REGISTERED')
            && incoming().registrationStage == 'PHONE_ONLY'
            && incoming().username == ''
            && incoming().xpProgress == 0
            && incoming().xpReward == 0
            && (!('reservedXp' in incoming()) || incoming().reservedXp == 0)
            && incoming().currentLevel == 'BRONZE'
            && (!('levelMode' in incoming()) || incoming().levelMode == 'AUTOMATIC')
            && incoming().branchId == cashierBranch()
            && incoming().preRegisteredBy == request.auth.uid
            && incoming().preRegisteredByRole == adminData().role
            && (!('registrationBonusGranted' in incoming()) || incoming().registrationBonusGranted == false)
            && incoming().referralCount == 0
          ) || (
            // Stage 2: Customer Online Completion ONLY from an existing PRE_REGISTERED record (BLOCKS public self-registration)
            isOwner(uid)
            && !exists(/databases/$(database)/documents/members/$(uid))
            && incoming().uid == uid
            && incoming().status == 'ACTIVE'
            && (!('registrationStatus' in incoming()) || incoming().registrationStatus == 'ACTIVE')
            && incoming().registrationStage == 'COMPLETED'
            && incoming().registrationBonusGranted == true
            && ('migratedFromUid' in incoming())
            && isPreRegId(incoming().migratedFromUid)
            && exists(/databases/$(database)/documents/members/$(incoming().migratedFromUid))
            && get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.status == 'PRE_REGISTERED'
            && incoming().whatsapp == get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.whatsapp
            && incoming().memberId == get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.memberId
            && getAfter(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.status == 'DELETED'
            && getAfter(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.mergedIntoUid == uid
            && (!('levelMode' in incoming()) || incoming().levelMode == 'AUTOMATIC')
            && incoming().referralCount == 0
            && (
              incoming().currentLevel == 'BRONZE' || (
                incoming().currentLevel in ['SILVER', 'JURAGAN', 'SULTAN']
                && exists(/databases/$(database)/documents/levels/$(incoming().currentLevel))
                && incoming().xpProgress >= get(/databases/$(database)/documents/levels/$(incoming().currentLevel)).data.minXp
              )
            )
            && (
              (
                incoming().referredByUid == null
                && incoming().referredByUsername == null
                && incoming().xpProgress == (get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.xpProgress + regBonusSetting())
                && incoming().xpReward == (get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.xpReward + regBonusSetting())
              ) || (
                incoming().referredByUid != null
                && incoming().referredByUid != uid
                && incoming().referredByUid != incoming().migratedFromUid
                && incoming().referredByUsername != null
                && exists(/databases/$(database)/documents/members/$(incoming().referredByUid))
                && get(/databases/$(database)/documents/members/$(incoming().referredByUid)).data.status == 'ACTIVE'
                && incoming().xpProgress == (get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.xpProgress + regBonusSetting() + refBonusSetting())
                && incoming().xpReward == (get(/databases/$(database)/documents/members/$(incoming().migratedFromUid)).data.xpReward + regBonusSetting() + refBonusSetting())
                && existsAfter(/databases/$(database)/documents/referrals/$('ref_' + uid))
              )
            )
          )
        ))
      );
      allow update: if isValidId(uid) && isValidMemberProfile(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            // Cashier Operational Action 1: Transaction XP (branch-locked, non-decreasing equal delta, never manual level override)
            isCashier()
            && existing().status in ['PRE_REGISTERED', 'ACTIVE']
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xpProgress', 'xpReward', 'currentLevel', 'levelMode', 'lastPlayAt', 'lastPlayBranch', 'updatedAt'
            ])
            && incoming().lastPlayBranch == cashierBranch()
            && incoming().xpProgress >= existing().xpProgress
            && incoming().xpReward >= existing().xpReward
            && (incoming().xpProgress - existing().xpProgress) == (incoming().xpReward - existing().xpReward)
            && (!('levelMode' in incoming()) || incoming().levelMode == ('levelMode' in existing() ? existing().levelMode : 'AUTOMATIC'))
          ) || (
            // Cashier Operational Action 2: Assisted Benefit Request XP Hold
            isCashier()
            && existing().status in ['PRE_REGISTERED', 'ACTIVE']
            && incoming().diff(existing()).affectedKeys().hasOnly(['xpReward', 'reservedXp', 'updatedAt'])
            && incoming().xpReward >= 0
            && incoming().xpReward < existing().xpReward
            && incoming().reservedXp == (('reservedXp' in existing() ? existing().reservedXp : 0) + (existing().xpReward - incoming().xpReward))
          ) || (
            // Cashier Operational Action 3: Benefit Request Approve / Deny / Refund Release
            isCashier()
            && existing().status in ['PRE_REGISTERED', 'ACTIVE']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xpProgress', 'xpReward', 'currentLevel', 'levelMode', 'reservedXp', 'updatedAt'
            ])
            && (!('levelMode' in incoming()) || incoming().levelMode == ('levelMode' in existing() ? existing().levelMode : 'AUTOMATIC'))
            && (
              (
                ('reservedXp' in existing())
                && incoming().reservedXp <= existing().reservedXp
                && incoming().xpProgress == existing().xpProgress
                && incoming().xpReward >= existing().xpReward
                && (incoming().xpReward - existing().xpReward) <= (existing().reservedXp - incoming().reservedXp)
              ) || (
                incoming().xpProgress > existing().xpProgress
                && (incoming().xpProgress - existing().xpProgress) == (incoming().xpReward - existing().xpReward)
              )
            )
          ) || (
            // Stage 2 Atomic Retirement of Stage 1 PRE_REGISTERED record
            isSignedIn()
            && isPreRegId(uid)
            && existing().status == 'PRE_REGISTERED'
            && incoming().status == 'DELETED'
            && incoming().registrationStatus == 'DELETED'
            && incoming().mergedIntoUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'registrationStatus', 'mergedIntoUid', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
          ) || (
            // Completed Active Member safe profile self-update
            isOwner(uid)
            && existing().status == 'ACTIVE'
            && (!('registrationStage' in existing()) || existing().registrationStage == 'COMPLETED')
            && incoming().uid == existing().uid
            && incoming().memberId == existing().memberId
            && incoming().username == existing().username
            && incoming().whatsapp == existing().whatsapp
            && incoming().status == existing().status
            && incoming().xpProgress == existing().xpProgress
            && incoming().xpReward == existing().xpReward
            && (
              (!('reservedXp' in incoming()) && !('reservedXp' in existing()))
              || (('reservedXp' in incoming()) && incoming().reservedXp == ('reservedXp' in existing() ? existing().reservedXp : 0))
            )
            && incoming().currentLevel == existing().currentLevel
            && incoming().currentCycleId == existing().currentCycleId
            && incoming().referredByUid == existing().referredByUid
            && incoming().referredByUsername == existing().referredByUsername
            && incoming().referralCount == existing().referralCount
            && incoming().lastPlayAt == existing().lastPlayAt
            && incoming().lastPlayBranch == existing().lastPlayBranch
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'socialMedia', 'preferredBranch',
              'birthDate', 'birthMonth', 'birthDay', 'memberCategory', 'updatedAt'
            ])
          ) || (
            // Completed Active Member self benefit-request XP Hold
            isOwner(uid)
            && existing().status == 'ACTIVE'
            && (!('registrationStage' in existing()) || existing().registrationStage == 'COMPLETED')
            && incoming().diff(existing()).affectedKeys().hasOnly(['xpReward', 'reservedXp', 'updatedAt'])
            && incoming().xpReward is int
            && incoming().xpReward >= 0
            && incoming().xpReward < existing().xpReward
            && incoming().reservedXp is int
            && incoming().reservedXp == (('reservedXp' in existing() ? existing().reservedXp : 0) + (existing().xpReward - incoming().xpReward))
          ) || (
            // Atomic referrer credit during Stage 2 online completion
            isSignedIn()
            && uid != request.auth.uid
            && existing().status == 'ACTIVE'
            && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/referrals/$('ref_' + request.auth.uid))
            && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredByUid == uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['xpProgress', 'xpReward', 'referralCount', 'updatedAt'])
            && incoming().xpProgress == existing().xpProgress + refBonusSetting()
            && incoming().xpReward == existing().xpReward + refBonusSetting()
            && incoming().referralCount == existing().referralCount + 1
          )
        ))
      );
      allow delete: if isSuperAdminRestoring() && isValidId(uid);
    }

    // ---------- Immutable Ledgers & Transactions ----------
    match /xpProgressLedger/{entryId} {
      allow get: if isValidId(entryId) && (
        isFullAdminOrSuper()
        || (isCashier() && existing().branch == cashierBranch())
        || (isSignedIn() && existing().memberUid == request.auth.uid)
      );
      allow list: if isFullAdminOrSuper()
        || (isCashier() && resource.data.branch == cashierBranch())
        || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(entryId) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            // Cashier can ONLY log operational transaction / campaign approval XP for own branch (NEVER ADMIN_ADJUSTMENT)
            isCashier()
            && incoming().createdBy == request.auth.uid
            && incoming().source in ['TRANSACTION', 'CHALLENGE', 'EVENT', 'PROMO']
            && (incoming().branch == null || incoming().branch == cashierBranch())
            && incoming().direction == 'CREDIT'
            && incoming().amount is int && incoming().amount > 0
          ) || (
            // Stage 2 Member one-time registration bonus & referral credit
            isSignedIn()
            && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/xpProgressLedger/$(entryId))
            && incoming().direction == 'CREDIT'
            && (
              (
                incoming().memberUid == request.auth.uid
                && incoming().source in ['REGISTRATION', 'REGISTRATION_BONUS']
                && incoming().amount == regBonusSetting()
              ) || (
                incoming().source == 'REFERRAL'
                && incoming().amount == refBonusSetting()
                && existsAfter(/databases/$(database)/documents/referrals/$('ref_' + request.auth.uid))
                && (
                  incoming().memberUid == request.auth.uid
                  || incoming().memberUid == getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredByUid
                )
              )
            )
          )
        ))
      );
      allow update, delete: if isSuperAdminRestoring() && isValidId(entryId);
    }

    match /xpRewardLedger/{entryId} {
      allow get: if isValidId(entryId) && (
        isFullAdminOrSuper()
        || (isCashier() && existing().branch == cashierBranch())
        || (isSignedIn() && existing().memberUid == request.auth.uid)
      );
      allow list: if isFullAdminOrSuper()
        || (isCashier() && resource.data.branch == cashierBranch())
        || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(entryId) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            // Cashier operational ledger ONLY for own branch (NEVER XP_REWARD_ADMIN_ADJUSTMENT / ADMIN_ADD / ADMIN_DEDUCT)
            isCashier()
            && incoming().createdBy == request.auth.uid
            && incoming().source in ['TRANSACTION', 'CHALLENGE', 'EVENT', 'PROMO', 'BENEFIT_REQUEST_HOLD', 'DENIED_REFUND', 'EXPIRY_REFUND']
            && (incoming().branch == null || incoming().branch == cashierBranch())
          ) || (
            // Stage 2 Member one-time registration bonus & referral credit
            isSignedIn()
            && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/xpRewardLedger/$(entryId))
            && incoming().direction == 'CREDIT'
            && (
              (
                incoming().memberUid == request.auth.uid
                && incoming().source in ['REGISTRATION', 'REGISTRATION_BONUS']
                && incoming().amount == regBonusSetting()
              ) || (
                incoming().source == 'REFERRAL'
                && incoming().amount == refBonusSetting()
                && existsAfter(/databases/$(database)/documents/referrals/$('ref_' + request.auth.uid))
                && (
                  incoming().memberUid == request.auth.uid
                  || incoming().memberUid == getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredByUid
                )
              )
            )
          ) || (
            // Completed Active Member Benefit Request XP Hold
            isSignedIn()
            && isActiveMember(request.auth.uid)
            && incoming().memberUid == request.auth.uid
            && incoming().type == 'REWARD'
            && incoming().direction == 'DEBIT'
            && incoming().source == 'BENEFIT_REQUEST_HOLD'
            && incoming().amount is int
            && incoming().amount < 0
            && incoming().referenceId is string
            && existsAfter(/databases/$(database)/documents/benefitRequests/$(incoming().referenceId))
            && getAfter(/databases/$(database)/documents/benefitRequests/$(incoming().referenceId)).data.holdLedgerId == entryId
            && getAfter(/databases/$(database)/documents/benefitRequests/$(incoming().referenceId)).data.xpCost == -incoming().amount
          )
        ))
      );
      allow update, delete: if isSuperAdminRestoring() && isValidId(entryId);
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && (
        isFullAdminOrSuper()
        || (isCashier() && existing().branch == cashierBranch())
        || (isSignedIn() && existing().memberUid == request.auth.uid)
      );
      allow list: if isFullAdminOrSuper()
        || (isCashier() && resource.data.branch == cashierBranch())
        || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(transactionId) && isValidTransaction(incoming()) && incoming().id == transactionId && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper()
          || (
            isCashier()
            && incoming().branch == cashierBranch()
            && incoming().adminId == request.auth.uid
          )
        ))
      );
      allow update, delete: if isSuperAdminRestoring() && isValidId(transactionId);
    }

    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && (
        isFullAdminOrSuper() || (isSignedIn() && (existing().referrerUid == request.auth.uid || existing().refereeUid == request.auth.uid))
      );
      allow list: if isFullAdminOrSuper() || (
        isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.refereeUid == request.auth.uid)
      );
      allow create: if isValidId(referralId) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            isSignedIn()
            && referralId == ('ref_' + request.auth.uid)
            && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
            && incoming().refereeUid == request.auth.uid
            && incoming().referrerUid != request.auth.uid
            && incoming().referrerXp == refBonusSetting()
            && incoming().refereeXp == refBonusSetting()
          )
        ))
      );
      allow update, delete: if isSuperAdminRestoring() && isValidId(referralId);
    }

    match /levelHistory/{historyId} {
      allow get: if isValidId(historyId) && (isFullAdminOrSuper() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(historyId) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper()
          || (isCashier() && incoming().source in ['TRANSACTION', 'CHALLENGE', 'EVENT', 'PROMO'])
        ))
      );
      allow update, delete: if isSuperAdminRestoring() && isValidId(historyId);
    }

    // ---------- Benefits & Campaigns (CRUD STRICTLY ADMIN/SUPER_ADMIN ONLY; Cashier Read + Atomic Stock/Claim Counter Only) ----------
    match /benefits/{benefitId} {
      allow get: if isValidId(benefitId) && (isFullAdminOrSuper() || (isSignedIn() && existing().active == true));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.active == true);
      allow create: if isValidId(benefitId) && isValidBenefit(incoming()) && (isSuperAdminRestoring() || (isFullAdminOrSuper() && !isSystemRestoreLocked()));
      allow update: if isValidId(benefitId) && isValidBenefit(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            isCashier()
            && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && existing().stock is int
            && incoming().stock is int
            && incoming().stock == existing().stock - 1
          )
        ))
      );
      allow delete: if isSuperAdminRestoring() && isValidId(benefitId);
    }

    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && (isFullAdminOrSuper() || (isSignedIn() && existing().active == true));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.active == true);
      allow create: if isValidId(campaignId) && isValidCampaign(incoming()) && (isSuperAdminRestoring() || (isFullAdminOrSuper() && !isSystemRestoreLocked()));
      allow update: if isValidId(campaignId) && isValidCampaign(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            isCashier()
            && incoming().diff(existing()).affectedKeys().hasOnly(['claimsCount', 'updatedAt'])
            && incoming().claimsCount == existing().claimsCount + 1
            && (existing().totalClaimLimit == null || incoming().claimsCount <= existing().totalClaimLimit)
          )
        ))
      );
      allow delete: if isSuperAdminRestoring() && isValidId(campaignId);
    }

    // ---------- Legacy Claims & Redemptions ----------
    match /claims/{claimId} {
      allow get: if isValidId(claimId) && (isFullAdminOrSuper() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(claimId) && isValidClaim(incoming()) && (
        isSuperAdminRestoring() || (
          isSignedIn()
          && !isSystemRestoreLocked()
          && isActiveMember(request.auth.uid)
          && incoming().memberUid == request.auth.uid
          && incoming().status == 'ON_PROCESS'
          && incoming().reviewedBy == null
          && incoming().reviewerRole == null
          && incoming().reviewedAt == null
          && incoming().denialReason == null
        )
      );
      allow update: if isValidId(claimId) && isValidClaim(incoming()) && (
        isSuperAdminRestoring() || (
          isAdmin()
          && !isSystemRestoreLocked()
          && existing().status == 'ON_PROCESS'
          && incoming().status in ['APPROVED', 'DENIED']
          && incoming().memberUid == existing().memberUid
          && incoming().campaignId == existing().campaignId
          && incoming().xpRewardSnapshot == existing().xpRewardSnapshot
          && incoming().createdAt == existing().createdAt
        )
      );
      allow delete: if isSuperAdminRestoring() && isValidId(claimId);
    }

    match /redemptions/{redemptionId} {
      allow get: if isValidId(redemptionId) && (isFullAdminOrSuper() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(redemptionId) && isValidRedemption(incoming()) && (
        isSuperAdminRestoring() || (
          isSignedIn()
          && !isSystemRestoreLocked()
          && isActiveMember(request.auth.uid)
          && incoming().memberUid == request.auth.uid
          && incoming().status == 'ON_PROCESS'
          && incoming().reviewedBy == null
          && incoming().reviewerRole == null
          && incoming().reviewedAt == null
          && incoming().denialReason == null
        )
      );
      allow update: if isValidId(redemptionId) && isValidRedemption(incoming()) && (
        isSuperAdminRestoring() || (
          isAdmin()
          && !isSystemRestoreLocked()
          && existing().status == 'ON_PROCESS'
          && incoming().status in ['APPROVED', 'DENIED']
          && incoming().memberUid == existing().memberUid
          && incoming().benefitId == existing().benefitId
          && incoming().xpCostSnapshot == existing().xpCostSnapshot
          && incoming().createdAt == existing().createdAt
        )
      );
      allow delete: if isSuperAdminRestoring() && isValidId(redemptionId);
    }

    // ---------- Unified Benefit Requests (XP Hold, 7-Day Validity, Cashier Assisted + Branch Isolation, Auto-Refund) ----------
    match /benefitRequests/{requestId} {
      allow get: if isValidId(requestId) && (
        isFullAdminOrSuper()
        || (isCashier() && (existing().branch == null || existing().branch == cashierBranch() || existing().usedBranch == cashierBranch()))
        || (isSignedIn() && existing().memberUid == request.auth.uid)
      );
      allow list: if isFullAdminOrSuper()
        || (isCashier() && (resource.data.branch == cashierBranch() || resource.data.usedBranch == cashierBranch()))
        || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(requestId) && isValidBenefitRequest(incoming()) && incoming().id == requestId && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          (
            // Cashier or Admin assisted Benefit Request (works for PRE_REGISTERED & ACTIVE; branch-locked for Cashier)
            (isFullAdminOrSuper() || (isCashier() && incoming().branch == cashierBranch()))
            && incoming().status == 'ON_PROCESS'
            && incoming().resolution == null
            && incoming().refundLedgerId == null
            && incoming().approvedAt == null
            && incoming().approvedBy == null
            && incoming().approvedByRole == null
            && incoming().deniedAt == null
            && incoming().deniedBy == null
            && incoming().deniedReason == null
            && incoming().expiresAt == null
            && incoming().expiredAt == null
            && incoming().usedAt == null
            && incoming().usedBy == null
            && incoming().usedBranch == null
            && incoming().receiptReference == null
            && incoming().refundedAt == null
            && incoming().refundReason == null
            && incoming().refundedAmount == 0
          ) || (
            // Completed Active Member self Benefit Request
            isSignedIn()
            && isActiveMember(request.auth.uid)
            && incoming().memberUid == request.auth.uid
            && incoming().status == 'ON_PROCESS'
            && incoming().resolution == null
            && incoming().refundLedgerId == null
            && incoming().approvedAt == null
            && incoming().approvedBy == null
            && incoming().approvedByRole == null
            && incoming().deniedAt == null
            && incoming().deniedBy == null
            && incoming().deniedReason == null
            && incoming().expiresAt == null
            && incoming().expiredAt == null
            && incoming().usedAt == null
            && incoming().usedBy == null
            && incoming().usedBranch == null
            && incoming().receiptReference == null
            && incoming().refundedAt == null
            && incoming().refundReason == null
            && incoming().refundedAmount == 0
            && (
              (
                incoming().sourceType in ['CHALLENGE', 'EVENT', 'PROMO']
                && exists(/databases/$(database)/documents/campaigns/$(incoming().sourceId))
                && get(/databases/$(database)/documents/campaigns/$(incoming().sourceId)).data.active == true
                && incoming().xpCost == 0
                && incoming().xpRewardGrant == get(/databases/$(database)/documents/campaigns/$(incoming().sourceId)).data.xpReward
                && incoming().holdLedgerId == null
              ) || (
                incoming().sourceType in ['GENERAL_BENEFIT', 'LEVEL_BENEFIT']
                && exists(/databases/$(database)/documents/benefits/$(incoming().sourceId))
                && get(/databases/$(database)/documents/benefits/$(incoming().sourceId)).data.active == true
                && incoming().xpCost == get(/databases/$(database)/documents/benefits/$(incoming().sourceId)).data.xpCost
                && incoming().xpRewardGrant == 0
                && (
                  (incoming().xpCost == 0 && incoming().holdLedgerId == null) || (
                    incoming().xpCost > 0
                    && incoming().holdLedgerId is string
                    && existsAfter(/databases/$(database)/documents/xpRewardLedger/$(incoming().holdLedgerId))
                    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.xpReward
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.xpReward - incoming().xpCost
                    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.reservedXp
                       == (('reservedXp' in get(/databases/$(database)/documents/members/$(request.auth.uid)).data
                          ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.reservedXp
                          : 0) + incoming().xpCost)
                  )
                )
              )
            )
          )
        ))
      );
      allow update: if isValidId(requestId) && isValidBenefitRequest(incoming()) && (
        isSuperAdminRestoring() || (
          !isSystemRestoreLocked()
          && (
            isFullAdminOrSuper()
            || (
              isCashier()
              && (existing().branch == null || existing().branch == cashierBranch())
              && (incoming().usedBranch == null || incoming().usedBranch == cashierBranch())
            )
          )
          && incoming().id == existing().id
          && incoming().memberId == existing().memberId
          && incoming().memberUid == existing().memberUid
          && incoming().sourceType == existing().sourceType
          && incoming().sourceId == existing().sourceId
          && incoming().xpCost == existing().xpCost
          && incoming().xpRewardGrant == existing().xpRewardGrant
          && incoming().createdAt == existing().createdAt
          && (
            (existing().status == 'ON_PROCESS' && incoming().status in ['APPROVED', 'DENIED', 'REFUNDED'])
            || (existing().status == 'APPROVED' && incoming().status in ['USED', 'EXPIRED', 'REFUNDED'])
          )
        )
      );
      allow delete: if isSuperAdminRestoring() && isValidId(requestId);
    }

    // ---------- Notifications ----------
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isFullAdminOrSuper() || (isCashier() && existing().targetType == 'ADMIN_ALERT')
      );
      allow list: if isFullAdminOrSuper() || (isCashier() && resource.data.targetType == 'ADMIN_ALERT');
      allow create: if isValidId(notificationId) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper()
          || (
            isCashier()
            && incoming().targetType == 'ADMIN_ALERT'
            && incoming().category == 'NEW_PRE_REGISTERED'
            && incoming().createdBy == request.auth.uid
          ) || (
            isSignedIn()
            && notificationId == ('new_member_' + request.auth.uid)
            && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
            && incoming().targetType == 'ADMIN_ALERT'
            && incoming().category == 'NEW_MEMBER_REGISTERED'
            && incoming().memberUid == request.auth.uid
            && incoming().createdBy == request.auth.uid
          )
        ))
      );
      allow update: if isValidId(notificationId) && (isSuperAdminRestoring() || (isFullAdminOrSuper() && !isSystemRestoreLocked()));
      allow delete: if isSuperAdminRestoring() && isValidId(notificationId);
    }

    match /memberNotifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isFullAdminOrSuper() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(notificationId) && isValidMemberNotification(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper()
          || (isCashier() && incoming().category in ['BENEFIT_REQUEST', 'LEVEL_UP'])
        ))
      );
      allow update: if isValidId(notificationId) && isValidMemberNotification(incoming()) && (
        isSuperAdminRestoring() || (!isSystemRestoreLocked() && (
          isFullAdminOrSuper() || (
            isOwner(existing().memberUid)
            && incoming().memberUid == existing().memberUid
            && incoming().memberId == existing().memberId
            && incoming().title == existing().title
            && incoming().message == existing().message
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt', 'status'])
          )
        ))
      );
      allow delete: if isSuperAdminRestoring() && isValidId(notificationId);
    }

    // ---------- Membership Cycles & Snapshots ----------
    match /membershipCycles/{cycleId} {
      allow get: if isValidId(cycleId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSuperAdmin() && isValidId(cycleId);
      allow delete: if isSuperAdminRestoring() && isValidId(cycleId);
    }

    match /cycleSnapshots/{snapshotId} {
      allow get: if isValidId(snapshotId) && (isFullAdminOrSuper() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isFullAdminOrSuper() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isSuperAdmin() && isValidId(snapshotId);
      allow update, delete: if isSuperAdminRestoring() && isValidId(snapshotId);
    }

    // ---------- Immutable Audit Logs (NEVER Deleted or Overwritten; Cashier Cannot Read Audit Logs) ----------
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isFullAdminOrSuper();
      allow list: if isFullAdminOrSuper();
      allow create: if isValidId(logId) && (
        isSuperAdmin()
        || (isFullAdminOrSuper() && !isSystemRestoreLocked())
        || (
          isCashier()
          && !isSystemRestoreLocked()
          && incoming().actorId == request.auth.uid
          && incoming().actorRole == adminData().role
          && incoming().action in [
            'CASHIER_LOGIN',
            'CASHIER_ACTION',
            'CASHIER_DENIED_ACTION',
            'PRE_REGISTERED_MEMBER_CREATED',
            'ONBOARDING_CODE_REGENERATED',
            'TRANSACTION_XP',
            'BENEFIT_REQUEST_CREATED',
            'BENEFIT_REQUEST_APPROVED',
            'BENEFIT_REQUEST_DENIED',
            'BENEFIT_REQUEST_DENIED_REFUNDED',
            'BENEFIT_REQUEST_USED',
            'BENEFIT_REQUEST_EXPIRED',
            'BENEFIT_REQUEST_EXPIRED_REFUNDED'
          ]
        )
      );
      allow update, delete: if false;
    }

    // ---------- CMS Homepage (STRICTLY ADMIN / SUPER_ADMIN ONLY; Cashier DENIED) ----------
    match /cmsPublished/{docId} {
      allow get: if docId == 'homepage';
      allow list: if isSuperAdmin();
      allow create, update: if docId == 'homepage' && isValidCmsPublished(incoming()) && (
        isSuperAdminRestoring() || (isFullAdminOrSuper() && !isSystemRestoreLocked())
      );
      allow delete: if isSuperAdminRestoring() && docId == 'homepage';
    }

    match /cmsDrafts/{docId} {
      allow get: if docId == 'homepage' && isAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if docId == 'homepage' && isValidCmsDraft(incoming()) && (
        isSuperAdminRestoring() || (isFullAdminOrSuper() && !isSystemRestoreLocked())
      );
      allow delete: if isSuperAdminRestoring() && docId == 'homepage';
    }

    match /cmsVersions/{versionId} {
      allow get: if isValidId(versionId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(versionId) && isValidCmsVersion(incoming()) && incoming().versionId == versionId && (
        isSuperAdminRestoring() || (isFullAdminOrSuper() && !isSystemRestoreLocked())
      );
      allow update: if isSuperAdminRestoring() && isValidId(versionId) && isValidCmsVersion(incoming()) && incoming().versionId == versionId;
      allow delete: if isSuperAdminRestoring() && isValidId(versionId);
    }

    // ---------- Immutable Admin XP Adjustment Audit Records (STRICTLY ADMIN / SUPER_ADMIN; Cashier DENIED) ----------
    match /xpAdjustments/{adjustmentId} {
      allow get: if isValidId(adjustmentId) && (isAdmin() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(adjustmentId) && isValidXpAdjustment(incoming()) && incoming().id == adjustmentId && (
        isSuperAdminRestoring() || (
          isFullAdminOrSuper()
          && !isSystemRestoreLocked()
          && incoming().adminId == request.auth.uid
          && !exists(/databases/$(database)/documents/xpAdjustments/$(adjustmentId))
        )
      );
      allow update: if isSuperAdminRestoring() && isValidId(adjustmentId) && isValidXpAdjustment(incoming()) && incoming().id == adjustmentId;
      allow delete: if isSuperAdminRestoring() && isValidId(adjustmentId);
    }

    // ---------- Immutable Admin Level Override & Recalculate Records (STRICTLY ADMIN / SUPER_ADMIN; Cashier DENIED) ----------
    match /levelOverrides/{overrideId} {
      allow get: if isValidId(overrideId) && (isAdmin() || (isSignedIn() && existing().memberUid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isValidId(overrideId) && isValidLevelOverride(incoming()) && incoming().id == overrideId && (
        isSuperAdminRestoring() || (
          isFullAdminOrSuper()
          && !isSystemRestoreLocked()
          && incoming().adminId == request.auth.uid
          && !exists(/databases/$(database)/documents/levelOverrides/$(overrideId))
        )
      );
      allow update: if isSuperAdminRestoring() && isValidId(overrideId) && isValidLevelOverride(incoming()) && incoming().id == overrideId;
      allow delete: if isSuperAdminRestoring() && isValidId(overrideId);
    }

    // ---------- Protected System Collections: Backups, Restore Jobs & System Operations (SUPER_ADMIN ONLY) ----------
    match /systemBackups/{backupId} {
      allow get: if isValidId(backupId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(backupId)
        && isSuperAdmin()
        && isValidSystemBackup(incoming())
        && incoming().backupId == backupId;
      allow delete: if isValidId(backupId)
        && isSuperAdmin()
        && !isSystemRestoreLocked()
        && existing().status in ['COMPLETED', 'FAILED', 'VERIFICATION_FAILED', 'CANCELLED'];
    }

    match /restoreJobs/{restoreJobId} {
      allow get: if isValidId(restoreJobId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(restoreJobId)
        && isSuperAdmin()
        && isValidRestoreJob(incoming())
        && incoming().restoreJobId == restoreJobId;
      allow delete: if false;
    }

    match /systemOperations/{opId} {
      allow get: if (opId == 'restoreLock' && isSignedIn())
        || (opId in ['restoreLock', 'backupLock', 'backupRetention'] && isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && (
        (opId == 'restoreLock' && isValidRestoreLock(incoming()))
        || (opId == 'backupLock' && isValidBackupLock(incoming()))
        || (opId == 'backupRetention' && isValidBackupRetention(incoming()))
      );
      allow delete: if false;
    }
  }
}
