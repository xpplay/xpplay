rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Core Primitives ----------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.\\-:]+$');
    }

    function isPreRegId(id) {
      return id is string && id.size() >= 10 && id.size() <= 80 && id.matches('^pre_[0-9]+_[a-f0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmailUser() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isBootstrappedSuperAdmin() {
      return isVerifiedEmailUser()
        && request.auth.token.email == 'spv.xpplay@gmail.com';
    }

    function adminDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // Strictly ADMIN and SUPER_ADMIN (NEVER includes CASHIER / STAFF)
    function isAdmin() {
      return isBootstrappedSuperAdmin()
        || (
          isVerifiedEmailUser()
          && adminDocExists()
          && adminData().active == true
          && adminData().role in ['SUPER_ADMIN', 'ADMIN']
        );
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin()
        || (isAdmin() && adminData().role == 'SUPER_ADMIN');
    }

    function isFullAdminOrSuper() {
      return isAdmin();
    }

    // Branch-isolated CASHIER (and legacy STAFF alias) — MUST have fixed branchScope DEMANG or SEKIP
    function isCashier() {
      return isVerifiedEmailUser()
        && adminDocExists()
        && adminData().active == true
        && adminData().role in ['CASHIER', 'STAFF']
        && adminData().branchScope in ['DEMANG', 'SEKIP'];
    }

    function cashierBranch() {
      return adminData().branchScope;
    }

    function isStaffOperator() {
      return isFullAdminOrSuper() || isCashier();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSystemRestoreLocked() {
      return exists(/databases/$(database)/documents/systemOperations/restoreLock)
        && get(/databases/$(database)/documents/systemOperations/restoreLock).data.locked == true;
    }

    function isSuperAdminRestoring() {
      return isSuperAdmin() && isSystemRestoreLocked();
    }

    function isActiveMember(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.status == 'ACTIVE'
        && (
          !('registrationStage' in get(/databases/$(database)/documents/members/$(uid)).data)
          || get(/databases/$(database)/documents/members/$(uid)).data.registrationStage == 'COMPLETED'
        );
    }

    function regBonusSetting() {
      return exists(/databases/$(database)/documents/systemSettings/default)
        ? get(/databases/$(database)/documents/systemSettings/default).data.registrationBonusXp
        : 10;
    }

    function refBonusSetting() {
      return exists(/databases/$(database)/documents/systemSettings/default)
        ? get(/databases/$(database)/documents/systemSettings/default).data.referralBonusXp
        : 5;
    }

    function isValidAuthIndexHash(id) {
      return id is string && id.size() == 66 && id.matches('^[uw]_[a-f0-9]{64}$');
    }

    function isValidWhatsappHash(id) {
      return id is string && id.size() == 66 && id.matches('^w_[a-f0-9]{64}$');
    }

    function isValidAuthIndex(data) {
      return data.keys().hasAll(['uid', 'authEmail', 'kind', 'createdAt'])
        && data.keys().hasOnly(['uid', 'authEmail', 'kind', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.authEmail is string && data.authEmail.size() >= 10 && data.authEmail.size() <= 120
        && data.authEmail.matches('^m_[a-zA-Z0-9_\\-]+@member\\.xpplay\\.app$')
        && data.kind in ['USERNAME', 'WHATSAPP']
        && data.createdAt is int;
    }

    function isValidOnboardingPublicStatus(data) {
      return data.keys().hasAll(['status', 'hasActiveCode', 'branchId', 'updatedAt'])
        && data.keys().hasOnly(['status', 'hasActiveCode', 'branchId', 'updatedAt'])
        && data.status in ['PRE_REGISTERED', 'ACTIVE', 'SUSPENDED', 'INACTIVE', 'DELETED']
        && data.hasActiveCode is bool
        && (data.branchId == null || data.branchId in ['DEMANG', 'SEKIP'])
        && data.updatedAt is int;
    }

    function isValidOnboardingVerification(data) {
      return data.keys().hasAll([
          'wHash', 'preMemberUid', 'memberId', 'branchId',
          'codeHmac', 'codeSalt', 'status', 'used',
          'attempts', 'maxAttempts', 'expiresAt',
          'issuedBy', 'issuedByRole', 'issuedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'wHash', 'preMemberUid', 'memberId', 'branchId',
          'codeHmac', 'codeSalt', 'status', 'used',
          'attempts', 'maxAttempts', 'expiresAt',
          'issuedBy', 'issuedByRole', 'issuedAt', 'updatedAt'
        ])
        && isValidWhatsappHash(data.wHash)
        && data.preMemberUid is string && data.preMemberUid.size() >= 1 && data.preMemberUid.size() <= 128
        && data.memberId is string && data.memberId.size() >= 4 && data.memberId.size() <= 40
        && data.branchId in ['DEMANG', 'SEKIP']
        && data.codeHmac is string && data.codeHmac.size() <= 128
        && data.codeSalt is string && data.codeSalt.size() <= 128
        && data.status in ['PENDING', 'VERIFIED', 'USED', 'REVOKED', 'EXPIRED']
        && data.used is bool
        && data.attempts is int && data.attempts >= 0 && data.attempts <= 20
        && data.maxAttempts is int && data.maxAttempts >= 1 && data.maxAttempts <= 10
        && data.expiresAt is int
        && data.issuedBy is string && data.issuedBy.size() >= 1 && data.issuedBy.size() <= 128
        && data.issuedByRole in ['SUPER_ADMIN', 'ADMIN', 'CASHIER', 'STAFF']
        && data.issuedAt is int
        && data.updatedAt is int;
    }

    // ---------- Entity Validation Helpers ----------
    function isValidBranch(data) {
      return data.keys().hasAll(['id', 'name', 'subtitle', 'whatsapp', 'mapsUrl', 'active'])
        && data.keys().hasOnly(['id', 'name', 'subtitle', 'whatsapp', 'mapsUrl', 'active'])
        && data.id in ['DEMANG', 'SEKIP']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 120
        && data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 20
        && data.mapsUrl is string && data.mapsUrl.size() >= 10 && data.mapsUrl.size() <= 300
        && data.active is bool;
    }

    function isValidLevelConfig(data) {
      return data.keys().hasAll(['id', 'name', 'rank', 'minXp', 'colorHex', 'description'])
        && data.keys().hasOnly(['id', 'name', 'rank', 'minXp', 'colorHex', 'description'])
        && data.id in ['BRONZE', 'SILVER', 'JURAGAN', 'SULTAN']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 40
        && data.rank is int && data.rank >= 1 && data.rank <= 4
        && data.minXp is int && data.minXp >= 0 && data.minXp <= 10000000
        && data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 12
        && data.description is string && data.description.size() <= 300;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'id', 'transactionXpRate', 'registrationBonusXp', 'referralBonusXp',
          'currentCycleId', 'resetEnabled', 'resetInterval', 'resetUnit',
          'nextResetAt', 'resetXpProgress', 'resetLevel', 'resetXpReward',
          'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'transactionXpRate', 'registrationBonusXp', 'referralBonusXp',
          'refundOnExpiry', 'currentCycleId', 'resetEnabled', 'resetInterval', 'resetUnit',
          'nextResetAt', 'resetXpProgress', 'resetLevel', 'resetXpReward',
          'updatedAt', 'updatedBy'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.transactionXpRate is int && data.transactionXpRate >= 100 && data.transactionXpRate <= 10000000
        && data.registrationBonusXp is int && data.registrationBonusXp >= 0 && data.registrationBonusXp <= 10000
        && data.referralBonusXp is int && data.referralBonusXp >= 0 && data.referralBonusXp <= 10000
        && (!('refundOnExpiry' in data) || data.refundOnExpiry is bool)
        && data.currentCycleId is string && data.currentCycleId.size() >= 2 && data.currentCycleId.size() <= 64
        && data.resetEnabled is bool
        && data.resetInterval is int && data.resetInterval >= 1 && data.resetInterval <= 3650
        && data.resetUnit in ['DAYS', 'MONTHS']
        && (data.nextResetAt == null || data.nextResetAt is int)
        && data.resetXpProgress is bool
        && data.resetLevel is bool
        && data.resetXpReward is bool
        && data.updatedAt is int
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'fullName', 'role', 'branchScope',
          'permissions', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'fullName', 'role', 'branchScope', 'branchId', 'cashierCode',
          'permissions', 'active', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.role in ['SUPER_ADMIN', 'ADMIN', 'CASHIER', 'STAFF']
        && (
          data.role in ['CASHIER', 'STAFF']
            ? data.branchScope in ['DEMANG', 'SEKIP']
            : data.branchScope in ['ALL', 'DEMANG', 'SEKIP']
        )
        && (!('branchId' in data) || data.branchId == null || data.branchId in ['DEMANG', 'SEKIP'])
        && (!('cashierCode' in data) || data.cashierCode == null || (data.cashierCode is string && data.cashierCode.size() <= 40))
        && data.permissions is map
        && data.active is bool
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function isValidMemberProfileCore(data) {
      return data.keys().hasAll([
          'uid', 'memberId', 'fullName', 'username', 'whatsapp',
          'socialMedia', 'status', 'xpProgress', 'xpReward',
          'currentLevel', 'currentCycleId', 'referredByUid',
          'referredByUsername', 'referralCount', 'lastPlayAt',
          'lastPlayBranch', 'preferredBranch', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'memberId', 'fullName', 'username', 'whatsapp',
          'socialMedia', 'birthDate', 'birthMonth', 'birthDay', 'memberCategory',
          'status', 'registrationStatus', 'registrationStage',
          'phone', 'normalizedPhone', 'branchId',
          'preRegisteredAt', 'preRegisteredBy', 'preRegisteredByRole', 'preRegistrationNotes',
          'registrationCompletedAt', 'verifiedPhoneAt', 'registrationBonusGranted',
          'authUid', 'migratedFromUid', 'mergedIntoUid',
          'xpProgress', 'xpReward', 'reservedXp',
          'currentLevel', 'levelMode', 'currentCycleId', 'referredByUid',
          'referredByUsername', 'referralCount', 'lastPlayAt',
          'lastPlayBranch', 'preferredBranch', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.memberId is string && data.memberId.size() >= 4 && data.memberId.size() <= 40
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.username is string
        && (
          (data.status in ['PRE_REGISTERED', 'DELETED'] && data.username == '')
          || (
            data.username.size() >= 3 && data.username.size() <= 24
            && data.username.matches('^[a-z0-9][a-z0-9._]*[a-z0-9]$')
          )
        )
        && data.whatsapp is string && data.whatsapp.size() >= 10 && data.whatsapp.size() <= 16
        && data.whatsapp.matches('^628[1-9][0-9]{6,11}$')
        && data.socialMedia is string && data.socialMedia.size() <= 100
        && (!('birthDate' in data) || data.birthDate == null || (data.birthDate is string && data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('birthMonth' in data) || data.birthMonth == null || (data.birthMonth is int && data.birthMonth >= 1 && data.birthMonth <= 12))
        && (!('birthDay' in data) || data.birthDay == null || (data.birthDay is int && data.birthDay >= 1 && data.birthDay <= 31))
        && (!('memberCategory' in data) || data.memberCategory == null || data.memberCategory in ['MAHASISWA', 'PELAJAR', 'PEKERJA', 'LAINNYA'])
        && data.status in ['PRE_REGISTERED', 'ACTIVE', 'SUSPENDED', 'INACTIVE', 'DELETED'];
    }

    function isValidMemberProfileExtended(data) {
      return (!('registrationStatus' in data) || data.registrationStatus in ['PRE_REGISTERED', 'ACTIVE', 'SUSPENDED', 'INACTIVE', 'DELETED'])
        && (!('registrationStage' in data) || data.registrationStage in ['PHONE_ONLY', 'COMPLETED'])
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('normalizedPhone' in data) || (data.normalizedPhone is string && data.normalizedPhone.size() <= 20))
        && (!('branchId' in data) || data.branchId == null || data.branchId in ['DEMANG', 'SEKIP'])
        && (!('preRegisteredAt' in data) || data.preRegisteredAt == null || data.preRegisteredAt is int)
        && (!('preRegisteredBy' in data) || data.preRegisteredBy == null || (data.preRegisteredBy is string && data.preRegisteredBy.size() <= 128))
        && (!('preRegisteredByRole' in data) || data.preRegisteredByRole == null || data.preRegisteredByRole in ['SUPER_ADMIN', 'ADMIN', 'CASHIER', 'STAFF'])
        && (!('preRegistrationNotes' in data) || data.preRegistrationNotes == null || (data.preRegistrationNotes is string && data.preRegistrationNotes.size() <= 300))
        && (!('registrationCompletedAt' in data) || data.registrationCompletedAt == null || data.registrationCompletedAt is int)
        && (!('verifiedPhoneAt' in data) || data.verifiedPhoneAt == null || data.verifiedPhoneAt is int)
        && (!('registrationBonusGranted' in data) || data.registrationBonusGranted is bool)
        && (!('authUid' in data) || data.authUid == null || (data.authUid is string && data.authUid.size() <= 128))
        && (!('migratedFromUid' in data) || data.migratedFromUid == null || (data.migratedFromUid is string && data.migratedFromUid.size() <= 128))
        && (!('mergedIntoUid' in data) || data.mergedIntoUid == null || (data.mergedIntoUid is string && data.mergedIntoUid.size() <= 128))
        && data.xpProgress is int && data.xpProgress >= 0
        && data.xpReward is int && data.xpReward >= 0
        && (!('reservedXp' in data) || (data.reservedXp is int && data.reservedXp >= 0))
        && data.currentLevel in ['BRONZE', 'SILVER', 'JURAGAN', 'SULTAN']
        && (!('levelMode' in data) || data.levelMode in ['AUTOMATIC', 'MANUAL_OVERRIDE', 'RESET'])
        && data.currentCycleId is string && data.currentCycleId.size() >= 2 && data.currentCycleId.size() <= 64
        && (data.referredByUid == null || (data.referredByUid is string && data.referredByUid.size() <= 128))
        && (data.referredByUsername == null || (data.referredByUsername is string && data.referredByUsername.size() <= 24))
        && data.referralCount is int && data.referralCount >= 0
        && (data.lastPlayAt == null || data.lastPlayAt is int)
        && (data.lastPlayBranch == null || data.lastPlayBranch in ['DEMANG', 'SEKIP'])
        && (data.preferredBranch == null || data.preferredBranch in ['DEMANG', 'SEKIP'])
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function isValidMemberProfile(data) {
      return isValidMemberProfileCore(data) && isValidMemberProfileExtended(data);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'id', 'memberId', 'memberUid', 'memberUsername', 'branch',
          'amountIdr', 'xpRateUsed', 'xpGenerated', 'source',
          'receiptNumber', 'note', 'adminId', 'adminName', 'cycleId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'memberId', 'memberUid', 'memberUsername', 'branch',
          'amountIdr', 'xpRateUsed', 'xpGenerated', 'source',
          'receiptNumber', 'note', 'adminId', 'adminName', 'cycleId', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.memberId is string && data.memberId.size() >= 4 && data.memberId.size() <= 40
        && data.memberUid is string && data.memberUid.size() >= 1 && data.memberUid.size() <= 128
        && data.memberUsername is string && data.memberUsername.size() <= 24
        && data.branch in ['DEMANG', 'SEKIP']
        && data.amountIdr is int && data.amountIdr > 0 && data.amountIdr <= 1000000000
        && data.xpRateUsed is int && data.xpRateUsed >= 100 && data.xpRateUsed <= 10000000
        && data.xpGenerated is int && data.xpGenerated >= 0 && data.xpGenerated <= 500000
        && data.source == 'TRANSACTION'
        && data.receiptNumber is string && data.receiptNumber.size() <= 64
        && data.note is string && data.note.size() <= 300
        && data.adminId is string && data.adminId.size() >= 1 && data.adminId.size() <= 128
        && data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 100
        && data.cycleId is string && data.cycleId.size() >= 2 && data.cycleId.size() <= 64
        && data.createdAt is int;
    }

    function isValidBenefit(data) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'imageUrl', 'xpCost',
          'levelRequirement', 'claimable', 'redeemable', 'stock',
          'expiryAt', 'terms', 'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'imageUrl', 'xpCost',
          'levelRequirement', 'claimable', 'redeemable', 'stock',
          'expiryAt', 'terms', 'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 600
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && data.xpCost is int && data.xpCost >= 0 && data.xpCost <= 1000000
        && data.levelRequirement in ['BRONZE', 'SILVER', 'JURAGAN', 'SULTAN']
        && data.claimable is bool
        && data.redeemable is bool
        && (data.stock == null || (data.stock is int && data.stock >= 0))
        && (data.expiryAt == null || data.expiryAt is int)
        && data.terms is string && data.terms.size() <= 600
        && data.active is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll([
          'id', 'type', 'title', 'description', 'startAt', 'endAt',
          'xpReward', 'imageUrl', 'terms', 'maxClaimsPerMember',
          'totalClaimLimit', 'claimsCount', 'active', 'status',
          'requiresEvidence', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'title', 'description', 'startAt', 'endAt',
          'xpReward', 'imageUrl', 'terms', 'maxClaimsPerMember',
          'totalClaimLimit', 'claimsCount', 'active', 'status',
          'requiresEvidence', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.type in ['CHALLENGE', 'EVENT', 'PROMO']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && data.startAt is int
        && data.endAt is int
        && data.endAt >= data.startAt
        && data.xpReward is int && data.xpReward >= 1 && data.xpReward <= 100000
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && data.terms is string && data.terms.size() <= 600
        && data.maxClaimsPerMember is int && data.maxClaimsPerMember >= 1 && data.maxClaimsPerMember <= 100
        && (data.totalClaimLimit == null || (data.totalClaimLimit is int && data.totalClaimLimit >= 1))
        && data.claimsCount is int && data.claimsCount >= 0
        && data.active is bool
        && data.status in ['DRAFT', 'ACTIVE', 'EXPIRED', 'DISABLED']
        && data.requiresEvidence is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function isValidClaim(data) {
      return data.keys().hasAll([
          'id', 'memberId', 'memberUid', 'memberUsername', 'campaignId',
          'campaignTitle', 'campaignType', 'xpRewardSnapshot',
          'evidenceUrl', 'evidencePath', 'note', 'status',
          'reviewedBy', 'reviewerRole', 'reviewedAt', 'denialReason',
          'cycleId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'memberId', 'memberUid', 'memberUsername', 'campaignId',
          'campaignTitle', 'campaignType', 'xpRewardSnapshot',
          'evidenceUrl', 'evidencePath', 'note', 'status',
          'reviewedBy', 'reviewerRole', 'reviewedAt', 'denialReason',
          'cycleId', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.memberId is string && data.memberId.size() >= 4 && data.memberId.size() <= 40
        && data.memberUid is string && data.memberUid.size() >= 1 && data.memberUid.size() <= 128
        && data.memberUsername is string && data.memberUsername.size() >= 3 && data.memberUsername.size() <= 24
        && data.campaignId is string && data.campaignId.size() >= 1 && data.campaignId.size() <= 128
        && data.campaignTitle is string && data.campaignTitle.size() >= 1 && data.campaignTitle.size() <= 120
        && data.campaignType in ['CHALLENGE', 'EVENT', 'PROMO']
        && data.xpRewardSnapshot is int && data.xpRewardSnapshot >= 0
        && data.evidenceUrl is string && data.evidenceUrl.size() <= 500
        && data.evidencePath is string && data.evidencePath.size() <= 300
        && data.note is string && data.note.size() <= 400
        && data.status in ['ON_PROCESS', 'APPROVED', 'DENIED']
        && (data.reviewedBy == null || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && (data.reviewerRole == null || data.reviewerRole in ['SUPER_ADMIN', 'ADMIN', 'CASHIER', 'STAFF'])
        && (data.reviewedAt == null || data.reviewedAt is int)
        && (data.denialReason == null || (data.denialReason is string && data.denialReason.size() <= 300))
        && data.cycleId is string && data.cycleId.size() >= 2 && data.cycleId.size() <= 64
        && data.createdAt is int;
    }

    function isValidRedemption(data) {
      return data.keys().hasAll([
          'id', 'memberId', 'memberUid', 'memberUsername', 'benefitId',
          'benefitName', 'xpCostSnapshot', 'levelRequirement', 'redemptionKind',
          'status', 'reviewedBy', 'reviewerRole', 'reviewedAt', 'denialReason',
          'cycleId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'memberId', 'memberUid', 'memberUsername', 'benefitId',
          'benefitName', 'xpCostSnapshot', 'levelRequirement', 'redemptionKind',
          'status', 'reviewedBy', 'reviewerRole', 'reviewedAt', 'denialReason',
          'cycleId', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.memberId is string && data.memberId.size() >= 4 && data.memberId.size() <= 40
        && data.memberUid is string && data.memberUid.size() >= 1 && data.memberUid.size() <= 128
        && data.memberUsername is string && data.memberUsername.size() >= 3 && data.memberUsername.size() <= 24
        && data.benefitId is string && data.benefitId.size() >= 1 && data.benefitId.size() <= 128
        && data.benefitName is string && data.benefitName.size() >= 1 && data.benefitName.size() <= 120
        && data.xpCostSnapshot is int && data.xpCostSnapshot >= 0
